{
  "name": "laqum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ላቁም? — real-time parking for Addis Ababa",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json --noEmit",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @laqum/db migrate",
    "db:codegen": "pnpm --filter @laqum/db codegen",
    "db:seed": "pnpm --filter @laqum/db seed",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "dev:stop": "node scripts/dev-stop.mjs",
    "chapa:sandbox": "node scripts/chapa-sandbox.mjs",
    "brand": "node scripts/brand/build.mjs",
    "brand:check": "node scripts/brand/build.mjs --check",
    "brand:previews": "node scripts/brand/build.mjs --previews",
    "e2e": "pnpm build && playwright test",
    "e2e:ui": "pnpm build && playwright test --ui",
    "e2e:install": "playwright install chromium",
    "db:codegen:verify": "pnpm --filter @laqum/db codegen:verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@laqum/db": "workspace:*",
    "@laqum/shared": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "imagetracerjs": "1.2.6",
    "kysely": "0.29.6",
    "prettier": "3.9.8",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
