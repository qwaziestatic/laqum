{
  "name": "laqum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "\u120b\u1241\u121d? \u2014 real-time parking for Addis Ababa",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @laqum/api db:migrate",
    "db:codegen": "pnpm --filter @laqum/api db:codegen",
    "db:seed": "pnpm --filter @laqum/api db:seed",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "chapa:sandbox": "node scripts/chapa-sandbox.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
