# ላቁም? production settings. Copy to deploy/.env.production (never
# committed) and fill in. docker-compose.prod.yml sets the rest itself:
# NODE_ENV=production, REDIS_URL, TRUST_PROXY_HOPS=1 (Caddy),
# PUBLIC_BASE_URL=https://$DOMAIN, SHUTDOWN_TIMEOUT_MS. The root .env.example
# documents every variable.

# The public name. Its DNS A record must point at this server's public IPv4
# before the first start, or Caddy cannot obtain a certificate.
DOMAIN=laqum.com.et

# The managed PostgreSQL 16. With `--profile local-db` instead:
#   DATABASE_URL=postgres://laqum:<POSTGRES_PASSWORD>@postgres:5432/laqum
DATABASE_URL=postgres://laqum:CHANGE_ME@CHANGE_ME:5432/laqum
# Only for --profile local-db.
POSTGRES_PASSWORD=

# Each at least 32 random characters, different from each other. To make one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Real money: chapa, with the LIVE keys. (The fake provider takes no money;
# its test page is never registered in production.)
PAYMENT_PROVIDER=chapa
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

LOG_LEVEL=info

# Backups: the second location in Ethiopia, independent of the hosting
# provider, as user@host:/directory. The SSH key and the host's pinned key go
# in deploy/secrets/backup_key and deploy/secrets/backup_known_hosts.
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
# 02:00 in Addis Ababa.
BACKUP_AT_UTC=23:00
