{
  "name": "@laqum/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/cli.ts",
    "seed": "tsx seed/seed.ts",
    "codegen": "kysely-codegen --dialect postgres --out-file src/generated.ts --exclude-pattern \"kysely_migration*\"",
    "codegen:verify": "kysely-codegen --dialect postgres --out-file src/generated.ts --exclude-pattern \"kysely_migration*\" --verify"
  },
  "dependencies": {
    "@laqum/shared": "workspace:*",
    "kysely": "0.29.6",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
