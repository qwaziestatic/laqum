{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Typecheck-only config: it covers tests, which must not be emitted.
    // tsconfig.build.json sets rootDir/outDir for the real build.
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "migrations/**/*.ts",
    "seed/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
