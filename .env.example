# Copy to .env and adjust. .env is gitignored; this file is committed.
# Every variable the code reads is documented here.

# ─── Runtime ──────────────────────────────────────────────────────────────
# One of: development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ─── Data stores ──────────────────────────────────────────────────────────
# Postgres 16. Host is `localhost` when running the API on the host machine,
# and `postgres` when the API runs inside docker compose.
DATABASE_URL=postgres://laqum:laqum@localhost:5432/laqum

# Redis 7, used by BullMQ (Phase 1) and the Socket.io adapter (Phase 3).
REDIS_URL=redis://localhost:6379

# ─── Integration tests ────────────────────────────────────────────────────
# Points at docker-compose.test.yml, which runs on non-default ports so a test
# run can never be aimed at the dev database by accident.
TEST_DATABASE_URL=postgres://laqum:laqum@localhost:55432/laqum_test
TEST_REDIS_URL=redis://localhost:56379

# ─── Auth ─────────────────────────────────────────────────────────────────
# REQUIRED in production; development and tests fall back to an obviously
# fake default. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Short-lived access token; long-lived rotating refresh token.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# OTPs are 6 digits, expire in 5 minutes, and allow at most 5 attempts.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# OTP request rate limits. The brief requires per-phone and per-IP limiting
# but does not specify numbers; these are chosen defaults.
OTP_RATE_LIMIT_PER_PHONE=3
OTP_RATE_LIMIT_PER_IP=10
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# ─── Jobs ─────────────────────────────────────────────────────────────────
# Run the BullMQ worker inside the API process.
RUN_WORKER=true
