# Copy to .env and adjust. .env is gitignored; this file is committed.
# Every variable the code reads is documented here.

# ─── Runtime ──────────────────────────────────────────────────────────────
# One of: development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ─── Data stores ──────────────────────────────────────────────────────────
# Postgres 16. Host is `localhost` when running the API on the host machine,
# and `postgres` when the API runs inside docker compose.
DATABASE_URL=postgres://laqum:laqum@localhost:5432/laqum

# Redis 7, used by BullMQ (Phase 1) and the Socket.io adapter (Phase 3).
REDIS_URL=redis://localhost:6379

# ─── Integration tests ────────────────────────────────────────────────────
# Points at docker-compose.test.yml, which runs on non-default ports so a test
# run can never be aimed at the dev database by accident.
TEST_DATABASE_URL=postgres://laqum:laqum@localhost:55432/laqum_test
TEST_REDIS_URL=redis://localhost:56379
