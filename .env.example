# Copy to .env and adjust. .env is gitignored; this file is committed.
# Every variable the code reads is documented here.

# ─── Runtime ──────────────────────────────────────────────────────────────
# One of: development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ─── Data stores ──────────────────────────────────────────────────────────
# Postgres 16. Host is `localhost` when running the API on the host machine,
# and `postgres` when the API runs inside docker compose.
DATABASE_URL=postgres://laqum:laqum@localhost:5432/laqum

# Redis 7, used by BullMQ (Phase 1) and the Socket.io adapter (Phase 3).
REDIS_URL=redis://localhost:6379

# ─── Integration tests ────────────────────────────────────────────────────
# Points at docker-compose.test.yml, which runs on non-default ports so a test
# run can never be aimed at the dev database by accident.
TEST_DATABASE_URL=postgres://laqum:laqum@localhost:55432/laqum_test
TEST_REDIS_URL=redis://localhost:56379

# ─── Auth ─────────────────────────────────────────────────────────────────
# REQUIRED in production; development and tests fall back to an obviously
# fake default. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Short-lived access token; long-lived rotating refresh token.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# OTPs are 6 digits, expire in 5 minutes, and allow at most 5 attempts.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# OTP request rate limits. The brief requires per-phone and per-IP limiting
# but does not specify numbers; these are chosen defaults.
OTP_RATE_LIMIT_PER_PHONE=3
OTP_RATE_LIMIT_PER_IP=10
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# ─── Jobs ─────────────────────────────────────────────────────────────────
# Run the BullMQ worker inside the API process.
RUN_WORKER=true

# ─── Payments ─────────────────────────────────────────────────────────────
# 'fake' for development and every automated test; 'chapa' for real money.
PAYMENT_PROVIDER=fake

# Chapa secret key. REQUIRED when PAYMENT_PROVIDER=chapa.
# Test keys are prefixed CHASECK_TEST-.
CHAPA_SECRET_KEY=

# The secret the webhook signature is checked against. We require the
# x-chapa-signature header (an HMAC of the payload) and deliberately reject
# chapa-signature, which is an HMAC of the secret with itself and therefore a
# constant that proves nothing about the body.
CHAPA_WEBHOOK_SECRET=dev-only-webhook-secret

CHAPA_BASE_URL=https://api.chapa.co

# Public origin Chapa calls back to, and returns the driver to.
PUBLIC_BASE_URL=http://localhost:3000

# How long past a hold deadline expiry keeps deferring while the provider is
# unreachable, before expiring anyway. A payment that lands after that is
# caught by the operator refund queue.
PAYMENT_VERIFY_DEFERRAL_MINUTES=15

# The fake provider sends the driver to a development checkout page on this
# API (PUBLIC_BASE_URL/dev/checkout/<ref>, never in production), where Pay or
# Fail decides the outcome, as at Chapa's. Unset, that is the ONLY way a fake
# payment succeeds. A number of seconds brings back the automatic success
# after that delay, for unattended runs; 0 = instant.
# FAKE_PAYMENT_DELAY_SECONDS=

# ─── Development conveniences ──────────────────────────────────────────────

# Enables POST /v1/auth/dev-login, which signs in any SEEDED phone number with
# no OTP. It exists for `pnpm dev` and the Playwright two-screen test.
#
# FAILS CLOSED, three ways:
#   - unset means disabled (the default below is false);
#   - only the exact string 'true' enables it — '1', 'yes' or 'TRUE' are a
#     startup error, never a silent enable;
#   - NODE_ENV=production disables it regardless of this value.
#
# Never set this in production. It is a complete bypass of authentication.
DEV_AUTH=false

# ─── Mobile app (apps/mobile) ──────────────────────────────────────────────

# The map needs NO key: MapLibre over OpenFreeMap tiles. There is nothing to
# register for and nothing to pay. See CLAUDE.md, "Map stack".

# Where the phone finds the API. MUST be the dev machine's LAN address on a
# real device: localhost on a phone means the phone, not your laptop.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/v1

# The EAS project id is NOT an environment variable: it is written literally
# in apps/mobile/app.config.ts (extra.eas.projectId), with `owner`.

# ─── Device-test seed (development only) ───────────────────────────────────

# Adds a small lot AT THESE COORDINATES so arrival, live distance, the
# location gate and the countdowns can be tested where you actually are.
# Short on purpose: 5-minute blocks, a 3-minute hold, six slots.
#
# Set BOTH or neither. The seed REFUSES to run these in production, and
# refuses a coordinate that is empty, unparseable or out of range rather than
# silently placing the lot at 0,0.
SEED_TEST_LOT_LAT=
SEED_TEST_LOT_LNG=
# Booking radius in metres. Default 150. Keep it small so walking a block
# flips the location gate.
SEED_TEST_LOT_RADIUS_M=150
