{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // The browser bundle is built by Vite, not tsc, so module resolution
    // follows the bundler's rules rather than Node's.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts"]
}
