{
  "name": "@laqum/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@laqum/db": "workspace:*",
    "@laqum/shared": "workspace:*",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "6.3.8",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "pino": "10.3.1",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
