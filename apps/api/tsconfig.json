{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Typecheck-only config: it covers tests and config files, which must not
    // be emitted. tsconfig.build.json sets rootDir/outDir for the real build.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
