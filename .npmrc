# Fail fast when a workspace package declares a dependency it does not have.
strict-peer-dependencies=false

# Keep the store layout strict: a package may only import what it declares.
# apps/mobile (Phase 4) may need node-linker=hoisted for Metro; if so it gets
# its own .npmrc rather than loosening the whole workspace.
node-linker=isolated

# Exact versions only. Every dependency in this repo is pinned deliberately.
save-exact=true
